{"id": "plugin-launch-existing-board", "area": "plugins", "kind": "guard", "pattern": "open installed plugin", "experience": "An installed contextual board must open through the plugin runtime without starting another coding agent or inventing a browser URL.", "rule": "Use plugin_request launch for an installed view.", "privacy": "commit-safe", "source": {"note": "Phoenix plugin-system plan: agent-triggered contextual views."}, "setup": {"role": "top", "mocks": {"plugin_list": {"plugins": [{"manifest": {"id": "project-board", "name": "Project Board", "version": "0.1.0", "apiVersion": 1, "server": {"command": "node", "args": ["server.mjs"]}, "views": [{"id": "board", "title": "Project Board", "tool": "board", "scope": "thread"}]}, "directory": "/home/user/board", "enabled": true}]}, "plugin_request": {"id": "launch-1", "pluginId": "project-board", "viewId": "board", "scope": {"projectId": "project-one", "threadId": "thread-one"}}}}, "prompt": "Open the installed Project Board plugin beside conversation thread-one in project project-one. Do not start an agent turn.", "expect": {"calls": [{"tool": "plugin_request", "args": {"request.action": "launch", "request.pluginId": "project-board", "request.viewId": "board", "request.scope.projectId": "project-one", "request.scope.threadId": "thread-one"}}], "callsMustNot": [{"tool": "delegate_task"}, {"tool": "t3_thread_launch"}, {"tool": "preview_open"}]}, "maxSteps": 6}
